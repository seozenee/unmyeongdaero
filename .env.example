# ─── 사이트 ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# ─── 랜딩 전용 임시 배포 ────────────────────────────────────
# 1 이면 백엔드(Supabase·PortOne) 없이 마케팅 화면만 띄운다.
# 로그인·결제·보관함·상담은 미들웨어가 /coming-soon 으로 돌리고 관련 API 는 503 을 준다.
# 정식 오픈 때는 이 값을 지우고 Supabase·PortOne 키를 채운다.
LANDING_ONLY=

# ─── 무료 시험 모드 ────────────────────────────────────────
# 1 이면 PortOne 키가 있어도 실제 결제창 대신 모의 승인으로 상품을 연다.
# 즉 모든 풀이가 공짜가 되므로, 실고객을 받기 전에 반드시 비워야 한다.
# 켜져 있으면 화면 상단에 '시험 모드' 띠가 뜬다.
FREE_ACCESS=

# ─── sazu.app 명리 계산 API (서버 전용) ─────────────────────
# sazu_free_* 키는 샘플 프로필 5종만 계산하는 샌드박스. 실고객 서비스는 Pro 키 필요.
SAZU_API_KEY=

# ─── Anthropic Claude (서버 전용) ───────────────────────────
# 비워 두면(개발 환경 한정) 명리 데이터 문장을 규칙으로 엮은 보고서로 대체된다.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ─── Supabase (DB + Kakao 로그인) ───────────────────────────
# 비워 두면(개발 환경 한정) .data/local-db.json + 개발용 로그인으로 대체된다.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── PortOne V2 결제 ────────────────────────────────────────
# 마스터 프롬프트의 PORTONE_API_KEY 는 V2 에서 아래 4개로 나뉜다.
# 비워 두면(개발 환경 한정) 모의 결제창으로 대체된다.
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=

# ─── fal.ai 웹툰 에셋 생성 (로컬에서 pnpm webtoon:generate 할 때만) ─
# 배포 환경변수에는 필요 없다. 생성된 이미지·영상은 public/webtoon 에 커밋된다.
FAL_KEY=

# ─── 개발용 로그인 쿠키 서명 (로컬 전용) ─────────────────────
DEV_SESSION_SECRET=

# Kakao REST API 키·Client Secret 은 앱 환경변수가 아니라
# Supabase 대시보드 > Authentication > Providers > Kakao 에 입력한다.
