# ─── 사이트 ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# ─── 랜딩 전용 임시 배포 ────────────────────────────────────
# 1 이면 백엔드(Supabase·PortOne) 없이 마케팅 화면만 띄운다.
# 로그인·결제·보관함·상담은 미들웨어가 /coming-soon 으로 돌리고 관련 API 는 503 을 준다.
# 정식 오픈 때는 이 값을 지우고 Supabase·PortOne 키를 채운다.
LANDING_ONLY=

# ─── 무료 시험 모드 ────────────────────────────────────────
# 1 이면 PortOne 키가 있어도 실제 결제창 대신 모의 승인으로 상품을 연다.
# 즉 모든 풀이가 공짜가 되므로, 실고객을 받기 전에 반드시 비워야 한다.
# 켜져 있으면 화면 상단에 '시험 모드' 띠가 뜬다.
FREE_ACCESS=

# ─── Anthropic Claude (서버 전용) ───────────────────────────
# 비워 두면(개발 환경 한정) 명리 데이터 문장을 규칙으로 엮은 보고서로 대체된다.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ─── Supabase (DB + Kakao 로그인) ───────────────────────────
# 비워 두면(개발 환경 한정) .data/local-db.json + 개발용 로그인으로 대체된다.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── 토스페이먼츠 (직접 연동) ───────────────────────────────
# 개발자센터 > 내 개발정보에서 발급. 결제창형(자체창)이므로 ck/sk 키를 쓴다.
# 테스트 키(test_ck_, test_sk_)로도 카드사 심사가 가능하다.
# 비워 두면(개발 환경 한정) 모의 결제창으로 대체된다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ─── fal.ai 웹툰 에셋 생성 (로컬에서 pnpm webtoon:generate 할 때만) ─
# 배포 환경변수에는 필요 없다. 생성된 이미지·영상은 public/webtoon 에 커밋된다.
FAL_KEY=

# ─── 운영 화면 (/admin) ─────────────────────────────────────
# 여기 적힌 이메일로 로그인한 사람만 /admin 에 들어올 수 있다. 쉼표로 여러 개.
# 비워 두면 아무도 못 들어온다(설정을 깜빡해도 전부 열리지 않게).
# 카카오 로그인은 이메일을 못 받는 경우가 있어, 운영자는 이메일·비밀번호로 로그인해야 한다.
ADMIN_EMAILS=

# ─── 알림톡 (풀이 완료 알림 + PDF 전달) ─────────────────────
# 여섯 개가 모두 있어야 실제로 나간다. 하나라도 비면 보낼 문구를 로그에 찍기만 한다.
# 채널 개설·발신프로필 등록·템플릿 심사가 먼저다 — docs/알림톡.md 참고.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=
KAKAO_PF_ID=
KAKAO_TEMPLATE_STARTED=
KAKAO_TEMPLATE_READY=

# ─── 개발용 로그인 쿠키 서명 (로컬 전용) ─────────────────────
DEV_SESSION_SECRET=

# Kakao REST API 키·Client Secret 은 앱 환경변수가 아니라
# Supabase 대시보드 > Authentication > Providers > Kakao 에 입력한다.
