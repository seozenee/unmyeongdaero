{
  "name": "sazu-daero",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm tokens:check && pnpm db:seed:check && next build",
    "webtoon:generate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-webtoon-assets.mts",
    "db:seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-report-seed.mts",
    "db:seed:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-report-seed.mts --check",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tokens": "node scripts/extract-design-tokens.mjs",
    "tokens:check": "node scripts/extract-design-tokens.mjs --check"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.100",
    "@anthropic-ai/sdk": "^0.125.0",
    "@portone/browser-sdk": "^0.1.10",
    "@portone/server-sdk": "^0.19.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@vercel/functions": "^3.9.7",
    "ai": "^7.0.97",
    "next": "^14.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@fal-ai/client": "^1.10.1",
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "^14.2.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.0",
    "typescript": "^5",
    "vitest": "^5.0.0",
    "yaml": "^2.5.0"
  }
}
